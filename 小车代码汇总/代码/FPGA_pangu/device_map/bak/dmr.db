    <table id="device_map_timing_constraint" title="Inferred clocks commands" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -period {1000} -waveform {0 500} -name {XR_FPGA|clk_sys} [get_ports {clk_sys}] -add</data>
        </row>
        <row>
            <data>set_clock_groups -name {Inferred_clock_group_0} -asynchronous -group [get_clocks {XR_FPGA|clk_sys}]</data>
        </row>
    </table>
