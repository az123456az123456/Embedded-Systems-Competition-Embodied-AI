// ACG138 GW5AT-60 PG484A，板载时钟 F13，P10 第二组均为 Bank1 / 3.3V。
IO_LOC "clk50m" F13;
IO_PORT "clk50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "motor_pwm" F16;
IO_PORT "motor_pwm" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "motor_in1" A16;
IO_PORT "motor_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "motor_in2" A15;
IO_PORT "motor_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "motor_en" F14;
IO_PORT "motor_en" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
