#!/bin/sh
# ACG138 driver-only package: only loads this module, no network configuration.
set -eu
module=/lib/modules/6.1.75/extra/acg138-rtl8821cu/8821cu.ko
config_hash=7114825305fb4b5f032a523d009ae4eaa321f1c816ff60f44eeaca3b9a0ec20f
module_hash=c0cd3b12d1d36905977758cab202255b9ef88fb95a2cbc17533c6f1ab18dc1b9
fail() { echo "RTL8821CU: $*" >&2; exit 1; }
case "${1:-start}" in
    start)
        [ "$(uname -m)" = aarch64 ] && [ "$(uname -r)" = 6.1.75 ] || fail 'Kernel/architecture mismatch; skipped.'
        [ -r /proc/config.gz ] || fail 'Kernel config unavailable; skipped.'
        actual=$(zcat /proc/config.gz | sha256sum | awk '{print $1}')
        [ "$actual" = "$config_hash" ] || fail 'Kernel config mismatch; skipped.'
        [ "$(sha256sum "$module" | awk '{print $1}')" = "$module_hash" ] || fail 'Module checksum mismatch; skipped.'
        if [ -d /sys/module/8821cu ]; then
            [ "$(cat /sys/module/8821cu/srcversion 2>/dev/null)" = 94E22DDFC21FC4A76E27889 ] || fail 'Different 8821cu already loaded.'
            exit 0
        fi
        insmod "$module" rtw_power_mgnt=0 rtw_ips_mode=0 rtw_enusbss=0
        ;;
    stop)
        # Shutdown leaves the module for the kernel; uninstall.sh handles removal.
        ;;
    *) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac
